@model IEnumerable<API_Consumer.Models.Student>

@{
    ViewData["Title"] = "Active Students";
}

<div class="header-section">
    <h1><i class="fas fa-check-circle text-success"></i> Active Students</h1>
    <p class="subtitle">Filtered using LINQ to JSON with complex queries</p>
</div>

<div class="stats-card">
    <i class="fas fa-users"></i>
    <span>Active Students: <strong>@ViewBag.Count</strong></span>
    <span class="badge bg-success ms-3">Enrolled within last 5 years</span>
</div>

<div class="table-responsive">
    <table class="table table-modern">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Course</th>
                <th>Enrollment Date</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            <div class="student-name">
                                <i class="fas fa-user-circle text-success"></i>
                                @item.Name
                            </div>
                        </td>
                        <td>@item.Email</td>
                        <td>
                            <a asp-action="ByCourse" asp-route-course="@item.Course" class="badge bg-info text-decoration-none">
                                @item.Course
                            </a>
                        </td>
                        <td>@item.EnrollmentDate.ToString("MMM dd, yyyy")</td>
                        <td>@item.Phone</td>
                        <td>
                            <div class="action-buttons">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center py-4">
                        <p class="text-muted">No active students found.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to All Students
    </a>
</div>

<div class="info-box mt-4">
    <h6><i class="fas fa-filter"></i> LINQ to JSON Filtering:</h6>
    <p class="mb-0">This view demonstrates advanced LINQ to JSON queries with multiple conditions - filtering active students enrolled within the last 5 years, ordered by enrollment date.</p>
</div>
