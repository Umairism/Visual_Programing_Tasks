@model IEnumerable<API_Consumer.Models.Student>

@{
    ViewData["Title"] = "Students by Course";
}

<div class="header-section">
    <h1><i class="fas fa-book"></i> Students in @ViewBag.Course</h1>
    <p class="subtitle">Filtered using LINQ to JSON queries</p>
</div>

<div class="stats-card">
    <i class="fas fa-users"></i>
    <span>Students in this course: <strong>@ViewBag.Count</strong></span>
</div>

<div class="table-responsive">
    <table class="table table-modern">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Enrollment Date</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.EnrollmentDate.ToString("MMM dd, yyyy")</td>
                        <td>@item.Phone</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center py-4">
                        <p class="text-muted">No students found in this course.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to All Students
    </a>
</div>
